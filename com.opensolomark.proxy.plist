<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.opensolomark.proxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/Library/Logs"; exec /usr/bin/env python3 "$HOME/OpenSoloMark/proxy.py" >> "$HOME/Library/Logs/opensolomark.log" 2>&amp;1</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LISTEN_HOST</key>
        <string>127.0.0.1</string>
        <key>LISTEN_PORT</key>
        <string>47123</string>
        <key>UPSTREAM_BASE</key>
        <string>https://opencode.ai</string>
        <key>SESSION_ID</key>
        <string>opensolomark-local</string>
        <key>ALLOWED_PREFIXES</key>
        <string>/inference/,/zen/</string>
        <key>UPSTREAM_TIMEOUT</key>
        <string>600</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
